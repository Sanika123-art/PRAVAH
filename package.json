{
  "name": "saksham-aicte-system",
  "version": "1.0.0",
  "description": "SAKSHAM — Integrated AICTE Approval Workflow Automation, Compliance Monitoring and Alert Management System (SIH PS 26262)",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "npm run prisma:generate --workspace=server",
    "db:migrate": "npm run prisma:migrate --workspace=server",
    "db:seed": "npm run prisma:seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "SAKSHAM Development Team (SIH 2026)",
  "license": "UNLICENSED"
}
