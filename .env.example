# SAKSHAM Environment Configuration Template
# Copy this file to .env and adjust parameters for local development.

# Environment
NODE_ENV=development
PORT=5000
CLIENT_PORT=5173

# Database (PostgreSQL)
# Local Docker Compose defaults: user=postgres, password=postgres, db=saksham_db, port=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saksham_db?schema=public"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_ENABLE_MOCK_DATA="true"

# Security & Sessions (Placeholders for upcoming authentication phases)
# Replace with a secure random secret in production
JWT_SECRET="placeholder_dev_jwt_secret_change_in_production_min32chars"
SESSION_SECRET="placeholder_dev_session_secret_change_in_production"

# AICTE System Integration Flags (Mock mode only in Phase 1)
ENABLE_EXTERNAL_AICTE_SYNC="false"
AICTE_PORTAL_API_ENDPOINT="https://portal.example.gov.in/api/v1/mock"
